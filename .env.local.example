# Copiar a .env.local (nunca commitear ese archivo — ver .gitignore) y
# llenar con los valores reales del proyecto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Requiere configurar el proveedor Google en Supabase Auth (Authentication >
# Providers > Google) con un Client ID/Secret de Google Cloud Console, scope
# adicional gmail.readonly habilitado. Paso manual — ver CLAUDE.md.

# Registro manual por chat (app/api/parse-expense). Sacar la key GRATIS en
# https://aistudio.google.com/apikey — NUNCA por Google Cloud Console /
# Vertex AI, esa puerta sí pide tarjeta. Ver CLAUDE.md para el detalle.
GEMINI_API_KEY=

# M3 — pipeline de Gmail (ver CLAUDE.md para la guía completa de setup)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_WEBHOOK_SECRET=
CRON_SECRET=

# M4 — recordatorio push de check-in (§5.2). Par de llaves generado una sola
# vez para el proyecto (no hay consola externa que configurar) — ver
# CLAUDE.md. VAPID_SUBJECT es un mailto de contacto, lo pide el estándar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
